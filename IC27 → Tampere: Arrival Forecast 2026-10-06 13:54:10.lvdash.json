{
  "datasets": [
    {
      "name": "ic27_forecast",
      "displayName": "IC27 Forecast (Next Thursday)",
      "config": {
        "version": "1.1",
        "source": "wojciech_dbx.gold.ic27_forecast",
        "dimensions": [
          {
            "name": "forecast_date",
            "expr": "forecast_date",
            "displayName": "Forecast Date"
          },
          {
            "name": "scheduled_arrival",
            "expr": "scheduled_arrival",
            "displayName": "Scheduled Arrival"
          },
          {
            "name": "forecast_arrival",
            "expr": "forecast_arrival",
            "displayName": "Forecasted Arrival"
          },
          {
            "name": "recommendation",
            "expr": "recommendation",
            "displayName": "Recommendation"
          }
        ],
        "measures": [
          {
            "name": "pct_on_time_by_1600",
            "expr": "CAST(MIN(pct_on_time_by_1600/100) AS DOUBLE)",
            "displayName": "% On Time by 16:00",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              },
              "abbreviation": "none",
              "hideGroupSeparator": true
            }
          },
          {
            "name": "avg_delay_min",
            "expr": "CAST(MAX(avg_delay) AS DOUBLE)",
            "displayName": "Avg Delay (min)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "median_delay_min",
            "expr": "CAST(MAX(median_delay) AS DOUBLE)",
            "displayName": "Median Delay (min)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "max_delay_ever",
            "expr": "CAST(MAX(max_delay) AS DOUBLE)",
            "displayName": "Max Historical Delay (min)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "days_of_data",
            "expr": "CAST(MAX(days) AS DOUBLE)",
            "displayName": "Historical Thursdays"
          }
        ]
      }
    },
    {
      "name": "ic27_thursdays",
      "displayName": "IC27 Thursdays — Historical Arrivals",
      "config": {
        "version": "1.1",
        "source": "wojciech_dbx.silver.ic27_thursdays",
        "dimensions": [
          {
            "name": "departureDate",
            "expr": "departureDate",
            "displayName": "Departure Date"
          },
          {
            "name": "delay_bucket",
            "expr": "differenceInMinutes",
            "displayName": "Delay (min)"
          },
          {
            "name": "delay_status",
            "expr": "CASE WHEN differenceInMinutes <= 2 THEN 'On Time' ELSE 'Late' END",
            "displayName": "Delay Status"
          }
        ],
        "measures": [
          {
            "name": "delay_minutes",
            "expr": "MAX(differenceInMinutes)",
            "displayName": "Delay (min)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "ride_count",
            "expr": "COUNT(1)",
            "displayName": "Number of Thursdays"
          }
        ]
      }
    },
    {
      "name": "ic27_all_days",
      "displayName": "IC27 — All Historical Arrivals",
      "config": {
        "version": "1.1",
        "source": "wojciech_dbx.silver.ic27_tpe_arrivals",
        "dimensions": [
          {
            "name": "departureDate",
            "expr": "CAST(departureDate AS DATE)",
            "displayName": "Departure Date"
          },
          {
            "name": "delay_bucket",
            "expr": "differenceInMinutes",
            "displayName": "Delay (min)"
          },
          {
            "name": "delay_status",
            "expr": "CASE WHEN differenceInMinutes <= 2 THEN 'On Time' ELSE 'Late' END",
            "displayName": "Delay Status"
          }
        ],
        "measures": [
          {
            "name": "delay_minutes",
            "expr": "MAX(differenceInMinutes)",
            "displayName": "Delay (min)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "ride_count",
            "expr": "COUNT(1)",
            "displayName": "Number of Days"
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "name": "a8753f44",
      "displayName": "Untitled page",
      "layout": [
        {
          "widget": {
            "name": "header_text",
            "multilineTextboxSpec": {
              "lines": [
                "## 🚂 IC27 → Tampere (TPE) — Next Thursday Arrival Forecast for the 16:15 match\n",
                "<p>&nbsp;</p>\n",
                "\n",
                "<span style=\"font-size:18px\">This dashboard forecasts the arrival time of IC27 at Tampere Station next Thursday based on </span><span style=\"font-size:18px\">**historical Thursday patterns**</span><span style=\"font-size:18px\">. The forecast uses the </span><span style=\"font-size:18px\">**median delay**</span><span style=\"font-size:18px\"> from past Thursdays. Scheduled arrival: </span><span style=\"font-size:18px\">**15:58**</span><span style=\"font-size:18px\">. Jaana's connection departs at </span><span style=\"font-size:18px\">**16:00**</span><span style=\"font-size:18px\">, so any delay over 2 minutes means she misses it.</span>"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "forecast_table",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ic27_forecast",
                  "fields": [
                    {
                      "name": "forecast_arrival",
                      "expression": "`forecast_arrival`"
                    },
                    {
                      "name": "recommendation",
                      "expression": "`recommendation`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "showDescription": false,
                "title": {
                  "value": "Forecast for Next Thursday",
                  "fields": []
                }
              },
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "recommendation",
                  "style": {
                    "fontSize": 40
                  }
                },
                "target": {
                  "fieldName": "forecast_arrival",
                  "rowNumber": 0,
                  "style": {
                    "fontSize": 40
                  },
                  "formatTemplate": "Train will probably arrive at {{ @formatted }}"
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 4,
            "y": 3,
            "width": 8,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi_pct_on_time",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ic27_forecast",
                  "fields": [
                    {
                      "name": "measure(pct_on_time_by_1600)",
                      "expression": "MEASURE(`pct_on_time_by_1600`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": {
                  "value": "Train % On Time by 16:00",
                  "fields": []
                }
              },
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(pct_on_time_by_1600)",
                  "rowNumber": 0,
                  "format": {
                    "type": "number-percent",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 2
                    }
                  },
                  "formatTemplate": "{{ @formatted }}"
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 6,
            "width": 4,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi_median_delay",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ic27_forecast",
                  "fields": [
                    {
                      "name": "measure(median_delay_min)",
                      "expression": "MEASURE(`median_delay_min`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": {
                  "value": "Median Delay (min)",
                  "fields": []
                }
              },
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(median_delay_min)",
                  "rowNumber": 0
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 4,
            "y": 6,
            "width": 4,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "bar_delay_by_date",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ic27_all_days",
                  "fields": [
                    {
                      "name": "delay_status",
                      "expression": "`delay_status`"
                    },
                    {
                      "name": "departureDate",
                      "expression": "`departureDate`"
                    },
                    {
                      "name": "measure(delay_minutes)",
                      "expression": "MEASURE(`delay_minutes`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": "IC27 Delay per Day (min) — Reference: 2 min = 16:00"
              },
              "version": 3,
              "annotations": [
                {
                  "type": "horizontal-line",
                  "encodings": {
                    "y": {
                      "dataValue": "2",
                      "dataType": "INTEGER"
                    },
                    "color": {
                      "value": {
                        "themeColorType": "visualizationColors",
                        "position": 4
                      }
                    }
                  }
                }
              ],
              "mark": {
                "colors": [
                  {
                    "themeColorType": "visualizationColors",
                    "position": 2
                  }
                ]
              },
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "departureDate",
                  "displayName": "departureDate",
                  "scale": {
                    "type": "categorical"
                  }
                },
                "y": {
                  "fieldName": "measure(delay_minutes)",
                  "displayName": "Delay (min)",
                  "scale": {
                    "type": "quantitative"
                  }
                },
                "color": {
                  "fieldName": "delay_status",
                  "scale": {
                    "type": "categorical",
                    "mappings": [
                      {
                        "value": "On Time",
                        "color": "#2E7D32"
                      },
                      {
                        "value": "Late",
                        "color": {
                          "themeColorType": "visualizationColors",
                          "position": 2
                        }
                      }
                    ]
                  }
                },
                "label": {
                  "show": true
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 9,
            "width": 12,
            "height": 9
          }
        },
        {
          "widget": {
            "name": "271644f4",
            "multilineTextboxSpec": {
              "lines": [
                "## <span style=\"text-align:center;display:block;\">Target IC27 Arrival Time</span>\n",
                "\n",
                "## <span style=\"text-align:center;display:block\"><span style=\"font-size:36px;line-height:1.5\">**16:00**</span></span>"
              ],
              "verticalAlign": "VERTICAL_ALIGN_CENTER"
            }
          },
          "position": {
            "x": 0,
            "y": 3,
            "width": 4,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "date_range_filter",
            "queries": [
              {
                "name": "dashboards/01f1c17ca07410c3a21bbd2bb20943cf/datasets/01f1c22bfd251d13b3a740b989af619d_departureDate",
                "query": {
                  "datasetName": "ic27_all_days",
                  "fields": [
                    {
                      "name": "departureDate",
                      "expression": "`departureDate`"
                    },
                    {
                      "name": "departureDate_associativity",
                      "expression": "COUNT_IF(`associative_filter_predicate_group`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "frame": {
                "showTitle": true,
                "title": {
                  "value": "Date Range",
                  "fields": []
                }
              },
              "widgetType": "filter-date-range-picker",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "departureDate",
                    "queryName": "dashboards/01f1c17ca07410c3a21bbd2bb20943cf/datasets/01f1c22bfd251d13b3a740b989af619d_departureDate"
                  }
                ]
              }
            }
          },
          "position": {
            "x": 8,
            "y": 6,
            "width": 4,
            "height": 3
          }
        }
      ],
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1"
    }
  ],
  "uiSettings": {
    "theme": {
      "widgetHeaderAlignment": "ALIGNMENT_UNSPECIFIED"
    },
    "applyModeEnabled": false
  }
