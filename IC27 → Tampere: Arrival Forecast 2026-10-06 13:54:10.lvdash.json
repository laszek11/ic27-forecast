{
  "datasets": [
    {
      "name": "ic27_forecast",
      "displayName": "IC27 Forecast (Next Thursday)",
      "config": {
        "version": "1.1",
        "source": "SELECT * FROM wojciech_dbx.bronze.ic27_forecast ORDER BY forecast_date DESC LIMIT 1\n",
        "dimensions": [
          {
            "name": "forecast_date",
            "expr": "forecast_date",
            "displayName": "Forecast Date"
          },
          {
            "name": "scheduled_arrival",
            "expr": "scheduled_arrival",
            "displayName": "Scheduled Arrival"
          },
          {
            "name": "forecast_arrival",
            "expr": "forecast_arrival",
            "displayName": "Forecasted Arrival"
          },
          {
            "name": "recommendation",
            "expr": "recommendation",
            "displayName": "Recommendation"
          }
        ],
        "measures": [
          {
            "name": "pct_on_time_by_1600",
            "expr": "MAX(pct_on_time_by_1600)",
            "displayName": "% On Time by 16:00",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "avg_delay_min",
            "expr": "MAX(avg_delay)",
            "displayName": "Avg Delay (min)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "median_delay_min",
            "expr": "CAST(MAX(median_delay) AS DOUBLE)",
            "displayName": "Median Delay (min)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "max_delay_ever",
            "expr": "CAST(MAX(max_delay) AS DOUBLE)",
            "displayName": "Max Historical Delay (min)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "days_of_data",
            "expr": "CAST(MAX(days) AS DOUBLE)",
            "displayName": "Historical Thursdays"
          }
        ]
      }
    },
    {
      "name": "ic27_thursdays",
      "displayName": "IC27 Thursdays — Historical Arrivals",
      "config": {
        "version": "1.1",
        "source": "wojciech_dbx.silver.ic27_thursdays",
        "dimensions": [
          {
            "name": "departureDate",
            "expr": "departureDate",
            "displayName": "Departure Date"
          },
          {
            "name": "delay_bucket",
            "expr": "differenceInMinutes",
            "displayName": "Delay (min)"
          }
        ],
        "measures": [
          {
            "name": "delay_minutes",
            "expr": "MAX(differenceInMinutes)",
            "displayName": "Delay (min)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "ride_count",
            "expr": "COUNT(1)",
            "displayName": "Number of Thursdays"
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "name": "a8753f44",
      "displayName": "Untitled page",
      "layout": [
        {
          "widget": {
            "name": "header_text",
            "multilineTextboxSpec": {
              "lines": [
                "## 🚂 IC27 → Tampere (TPE) — Next Thursday Arrival Forecast\n",
                "\n",
                "Will Jaana catch her connection? This dashboard forecasts the arrival time of IC27 at Tampere Station next Thursday based on **historical Thursday patterns**. The forecast uses the **median delay** from past Thursdays — more robust to outliers than the mean. Scheduled arrival: **15:58**. Jaana's connection departs at **16:00**, so any delay over 2 minutes means she misses it."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "forecast_table",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ic27_forecast",
                  "fields": [
                    {
                      "name": "forecast_date",
                      "expression": "`forecast_date`"
                    },
                    {
                      "name": "scheduled_arrival",
                      "expression": "`scheduled_arrival`"
                    },
                    {
                      "name": "forecast_arrival",
                      "expression": "`forecast_arrival`"
                    },
                    {
                      "name": "recommendation",
                      "expression": "`recommendation`"
                    },
                    {
                      "name": "pct_on_time_by_1600",
                      "expression": "`pct_on_time_by_1600`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": "Forecast for Next Thursday"
              },
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {
                    "fieldName": "forecast_date"
                  },
                  {
                    "fieldName": "scheduled_arrival"
                  },
                  {
                    "fieldName": "forecast_arrival"
                  },
                  {
                    "fieldName": "recommendation"
                  },
                  {
                    "fieldName": "pct_on_time_by_1600"
                  }
                ]
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 12,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi_pct_on_time",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ic27_forecast",
                  "fields": [
                    {
                      "name": "measure(pct_on_time_by_1600)",
                      "expression": "MEASURE(`pct_on_time_by_1600`)"
                    }
